rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFaction(f) {
      return f is string && (f == 'stalker' || f == 'bandit');
    }

    function isValidShortString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidUserProfile(data) {
      return isValidId(data.userId) &&
             data.userId == request.auth.uid &&
             isValidShortString(data.callsign, 1, 32) &&
             isValidFaction(data.faction) &&
             data.money is int && data.money >= 0 && data.money <= 999999999 &&
             data.kills is int && data.kills >= 0 && data.kills <= 1000000 &&
             data.deaths is int && data.deaths >= 0 && data.deaths <= 1000000 &&
             data.artifactsFound is int && data.artifactsFound >= 0 && data.artifactsFound <= 1000000 &&
             isValidShortString(data.armorId, 1, 40) &&
             isValidShortString(data.primaryWeaponId, 1, 40) &&
             isValidShortString(data.secondaryWeaponId, 1, 40) &&
             isValidId(data.sectorId) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSectorPlayer(data, sectorId, playerId) {
      return isValidId(data.userId) &&
             data.userId == request.auth.uid &&
             data.userId == playerId &&
             isValidId(data.sectorId) &&
             data.sectorId == sectorId &&
             isValidShortString(data.callsign, 1, 32) &&
             isValidFaction(data.faction) &&
             isValidShortString(data.weaponId, 1, 40) &&
             data.x is number && data.x >= -300 && data.x <= 300 &&
             data.y is number && data.y >= -20 && data.y <= 120 &&
             data.z is number && data.z >= -300 && data.z <= 300 &&
             data.yaw is number && data.yaw >= -1000 && data.yaw <= 1000 &&
             data.hp is int && data.hp >= 0 && data.hp <= 200 &&
             data.moving is bool &&
             data.firing is bool &&
             data.online is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPvpHit(data, sectorId) {
      return isValidId(data.attackerUid) &&
             data.attackerUid == request.auth.uid &&
             isValidShortString(data.attackerName, 1, 32) &&
             isValidFaction(data.attackerFaction) &&
             isValidId(data.targetUid) &&
             data.targetUid != request.auth.uid &&
             isValidId(data.sectorId) &&
             data.sectorId == sectorId &&
             data.damage is int && data.damage >= 1 && data.damage <= 120 &&
             data.headshot is bool &&
             isValidShortString(data.weapon, 1, 48) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidChatMessage(data, sectorId) {
      return isValidId(data.userId) &&
             data.userId == request.auth.uid &&
             isValidId(data.sectorId) &&
             data.sectorId == sectorId &&
             isValidShortString(data.callsign, 1, 32) &&
             isValidFaction(data.faction) &&
             isValidShortString(data.text, 1, 160) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 1. Private User Cloud Profile (Owner-Only)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'callsign', 'faction', 'money', 'kills', 'deaths', 'artifactsFound',
                         'armorId', 'primaryWeaponId', 'secondaryWeaponId', 'sectorId', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'callsign', 'faction', 'money', 'kills', 'deaths', 'artifactsFound',
                         'armorId', 'primaryWeaponId', 'secondaryWeaponId', 'sectorId', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'callsign', 'faction', 'money', 'kills', 'deaths', 'artifactsFound',
                         'armorId', 'primaryWeaponId', 'secondaryWeaponId', 'sectorId', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. Live Online Sector Players (Public non-PII presence for active sector members, owner-only writes)
    match /sectors/{sectorId}/players/{playerId} {
      allow get: if isSignedIn() &&
                    isValidId(sectorId) &&
                    isValidId(playerId) &&
                    (request.auth.uid == playerId || (existing().sectorId == sectorId && existing().online == true));

      allow list: if isSignedIn() &&
                     isValidId(sectorId) &&
                     resource.data.sectorId == sectorId &&
                     resource.data.online == true;

      allow create: if isSignedIn() &&
                       isValidId(sectorId) &&
                       isValidId(playerId) &&
                       request.auth.uid == playerId &&
                       incoming().keys().hasAll([
                         'userId', 'sectorId', 'callsign', 'faction', 'weaponId',
                         'x', 'y', 'z', 'yaw', 'hp', 'moving', 'firing', 'online',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'sectorId', 'callsign', 'faction', 'weaponId',
                         'x', 'y', 'z', 'yaw', 'hp', 'moving', 'firing', 'online',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidSectorPlayer(incoming(), sectorId, playerId);

      allow update: if isSignedIn() &&
                       isValidId(sectorId) &&
                       isValidId(playerId) &&
                       isValidSectorPlayer(incoming(), sectorId, playerId) &&
                       request.auth.uid == playerId &&
                       incoming().userId == existing().userId &&
                       incoming().sectorId == existing().sectorId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'callsign', 'faction', 'weaponId', 'x', 'y', 'z', 'yaw',
                           'hp', 'moving', 'firing', 'online', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['online', 'updatedAt'])
                       );

      allow delete: if isSignedIn() && isValidId(sectorId) && isValidId(playerId) && request.auth.uid == playerId;
    }

    // 3. Real-Time PvP Combat Hit Events (Attacker creates, victim reads & deletes)
    match /sectors/{sectorId}/pvp_hits/{hitId} {
      allow get: if isSignedIn() &&
                    isValidId(sectorId) &&
                    isValidId(hitId) &&
                    (existing().targetUid == request.auth.uid || existing().attackerUid == request.auth.uid);

      allow list: if isSignedIn() &&
                     isValidId(sectorId) &&
                     resource.data.targetUid == request.auth.uid &&
                     resource.data.sectorId == sectorId;

      allow create: if isSignedIn() &&
                       isValidId(sectorId) &&
                       isValidId(hitId) &&
                       incoming().keys().hasAll([
                         'attackerUid', 'attackerName', 'attackerFaction', 'targetUid',
                         'sectorId', 'damage', 'headshot', 'weapon', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'attackerUid', 'attackerName', 'attackerFaction', 'targetUid',
                         'sectorId', 'damage', 'headshot', 'weapon', 'createdAt'
                       ]) &&
                       isValidPvpHit(incoming(), sectorId);

      allow update: if false;

      allow delete: if isSignedIn() &&
                       isValidId(sectorId) &&
                       isValidId(hitId) &&
                       existing().targetUid == request.auth.uid;
    }

    // 4. Real-Time PDA Sector Radio Chat (Scoped by sectorId, immutable messages)
    match /sectors/{sectorId}/chat/{msgId} {
      allow get: if isSignedIn() && isValidId(sectorId) && isValidId(msgId) && existing().sectorId == sectorId;

      allow list: if isSignedIn() && isValidId(sectorId) && resource.data.sectorId == sectorId;

      allow create: if isSignedIn() &&
                       isValidId(sectorId) &&
                       isValidId(msgId) &&
                       incoming().keys().hasAll([
                         'userId', 'sectorId', 'callsign', 'faction', 'text', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'sectorId', 'callsign', 'faction', 'text', 'createdAt'
                       ]) &&
                       isValidChatMessage(incoming(), sectorId);

      allow update: if false;

      allow delete: if isSignedIn() && isValidId(sectorId) && isValidId(msgId) && existing().userId == request.auth.uid;
    }
  }
}
